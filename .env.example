# Miracle Hostel Management Portal - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Flask Environment & Security
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate_a_secure_random_key_here_for_production_use_only

# Database Configuration (PostgreSQL in production)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miracle_hostel

# Data Protection & Encryption Keys
# AES encryption key used to encrypt sensitive Aadhaar numbers at rest
AADHAAR_ENCRYPTION_KEY=miracle-secret-aadhaar-key-32-chars!!

# Administrative Account Credentials
ADMIN_EMAIL=admin@123
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=1234

# Session & Security Settings
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Retention Policy Settings
# Resident records with status 'LEFT' remain available for this number of days before deletion eligibility
RESIDENT_RETENTION_DAYS=30

# Private Photograph & Object Storage Configuration
# Options: 'local_private' (default; stored in storage/private/ outside public web tree) or 's3' (private cloud bucket)
STORAGE_BACKEND=local_private
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
