# ==============================================================================
# Miracle Hostel Management Portal - Environment Configuration Template
# For production deployment on Render & Supabase PostgreSQL
# DO NOT COMMIT REAL SECRETS OR SENSITIVE VALUES TO VERSION CONTROL
# ==============================================================================

# Flask Core Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=false

# Security & Session Keys
# Generate a cryptographically secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Persistent Database (Supabase PostgreSQL)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Sensitive Data Encryption
# AES-256 key for resident Aadhaar encryption (must be exactly 32 bytes)
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
AADHAAR_ENCRYPTION_KEY=

# Administrative Account Credentials (Used during initial setup / create-admin)
ADMIN_EMAIL=admin@miraclehostel.com
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=

# Session Security & Rate Limiting
SESSION_COOKIE_SECURE=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Permanent Private Photograph Storage Backend
# Options: 'google_drive' (recommended for Render), 'local_private' (dev only), or 's3'
STORAGE_BACKEND=google_drive

# Google Drive Storage Integration (OAuth 2.0 with Dedicated Google Account)
# Run `python scripts/google_drive_auth.py` locally to obtain the refresh token
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Automated Data Retention & Deletion Policy
# Days after leaving date when departed resident records become eligible for permanent deletion
RESIDENT_RETENTION_DAYS=30
